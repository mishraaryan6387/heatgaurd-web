# Set these in the Render dashboard (Environment tab). The backend reads them from the
# process environment; it does not load a .env file.

# Comma-separated deployed frontend URLs allowed by CORS (localhost is always allowed).
FRONTEND_ORIGINS=https://heatgaurd.vercel.app

# Python version Render should use.
PYTHON_VERSION=3.12.8

# Optional Open-Meteo commercial API key. Without it the free endpoint is used,
# which often returns 429 on shared hosting IPs such as Render's free tier.
OPEN_METEO_API_KEY=

# How long (seconds) to reuse a weather response for the same location. Default 1800.
WEATHER_CACHE_TTL_SECONDS=1800
